import random

def play_hangman():
    # 1. Predefined list of 5 words
    words = ["python", "coding", "program", "laptop", "guitar"]
    
    # Randomly choose a secret word from the list
    secret_word = random.choice(words)
    
    # Track guessed letters and maximum allowed incorrect guesses
    guessed_letters = []
    max_incorrect_guesses = 6
    incorrect_guesses = 0

    print("=" * 30)
    print("      WELCOME TO HANGMAN!     ")
    print("=" * 30)
    print(f"You have {max_incorrect_guesses} incorrect guesses allowed.\n")

    # Game loop
    while incorrect_guesses < max_incorrect_guesses:
        # Build the display string with guessed letters and underscores
        display_word = []
        for letter in secret_word:
            if letter in guessed_letters:
                display_word.append(letter)
            else:
                display_word.append("_")
        
        # Show current progress
        print("Word:", " ".join(display_word))
        print(f"Incorrect guesses left: {max_incorrect_guesses - incorrect_guesses}")
        print(f"Guessed letters: {', '.join(guessed_letters) if guessed_letters else 'None'}")
        
        # Check if the player has guessed all letters
        if "_" not in display_word:
            print("\n Congratulations! You guessed the word correctly!")
            break

        # Get player input
        guess = input("Enter a letter: ").lower().strip()

        # Input validation
        if len(guess) != 1 or not guess.isalpha():
            print(" Invalid input! Please enter a single alphabetical letter.\n")
            continue
        
        if guess in guessed_letters:
            print(f" You already guessed '{guess}'. Try another letter.\n")
            continue

        # Add guess to history
        guessed_letters.append(guess)

        # Check if the guess is in the secret word
        if guess in secret_word:
            print(f" Good job! '{guess}' is in the word.\n")
        else:
            incorrect_guesses += 1
            print(f" Sorry, '{guess}' is not in the word.\n")

    # If the player runs out of guesses
    if incorrect_guesses == max_incorrect_guesses:
        print("=" * 30)
        print(" Game Over! You ran out of guesses.")
        print(f"The word was: {secret_word}")
        print("=" * 30)

# Run the game
if __name__ == "__main__":
    play_hangman()
