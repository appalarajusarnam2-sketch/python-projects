import csv

def stock_portfolio_tracker():
    # 1. Hardcoded dictionary with stock prices (USD)
    stock_prices = {
        "AAPL": 180,
        "TSLA": 250,
        "GOOGL": 140,
        "AMZN": 175,
        "MSFT": 400
    }

    print("=" * 45)
    print("        STOCK PORTFOLIO TRACKER        ")
    print("=" * 45)
    print("Available stocks and prices:")
    for ticker, price in stock_prices.items():
        print(f"  - {ticker}: ${price}")
    print("=" * 45)

    portfolio = []
    total_investment = 0.0

    # 2. User input loop
    while True:
        symbol = input("\nEnter stock symbol (or 'done' to finish): ").strip().upper()

        if symbol == "DONE":
            break

        if symbol not in stock_prices:
            print(f"❌ '{symbol}' is not available. Please choose from: {', '.join(stock_prices.keys())}")
            continue

        try:
            quantity = int(input(f"Enter quantity of {symbol} shares: "))
            if quantity <= 0:
                print("❌ Quantity must be a positive integer.")
                continue
        except ValueError:
            print("❌ Invalid input! Please enter a whole number for quantity.")
            continue

        price_per_share = stock_prices[symbol]
        subtotal = quantity * price_per_share
        total_investment += subtotal

        # Save details for the summary and export
        portfolio.append({
            "symbol": symbol,
            "quantity": quantity,
            "price": price_per_share,
            "subtotal": subtotal
        })

        print(f"✅ Added {quantity} shares of {symbol} (${subtotal:,.2f})")

    # 3. Display summary
    print("\n" + "=" * 45)
    print("              PORTFOLIO SUMMARY              ")
    print("=" * 45)

    if not portfolio:
        print("No stocks were added.")
        return

    print(f"{'Stock':<10}{'Qty':<8}{'Price':<10}{'Total':<10}")
    print("-" * 45)
    for item in portfolio:
        print(f"{item['symbol']:<10}{item['quantity']:<8}${item['price']:<9.2f}${item['subtotal']:<9.2f}")
    print("-" * 45)
    print(f"Total Investment Value: ${total_investment:,.2f}")
    print("=" * 45)

    # 4. Optional: Save to file (.txt or .csv)
    save_choice = input("\nWould you like to save this summary to a file? (txt/csv/no): ").strip().lower()

    if save_choice == "txt":
        with open("portfolio_summary.txt", "w") as file:
            file.write("PORTFOLIO SUMMARY\n")
            file.write("=" * 35 + "\n")
            for item in portfolio:
                file.write(f"{item['symbol']} | Qty: {item['quantity']} | Price: ${item['price']} | Total: ${item['subtotal']:.2f}\n")
            file.write("=" * 35 + "\n")
            file.write(f"Total Investment: ${total_investment:,.2f}\n")
        print(" Saved to 'portfolio_summary.txt' successfully!")

    elif save_choice == "csv":
        with open("portfolio_summary.csv", "w", newline="") as file:
            writer = csv.writer(file)
            writer.writerow(["Symbol", "Quantity", "Price per Share ($)", "Subtotal ($)"])
            for item in portfolio:
                writer.writerow([item["symbol"], item["quantity"], item["price"], item["subtotal"]])
            writer.writerow([])
            writer.writerow(["Total Investment", "", "", f"${total_investment:,.2f}"])
        print(" Saved to 'portfolio_summary.csv' successfully!")

if __name__ == "__main__":
    stock_portfolio_tracker()
