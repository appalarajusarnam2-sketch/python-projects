import os
import shutil

def organize_jpg_images(source_dir, destination_dir):
    # Ensure source directory exists
    if not os.path.exists(source_dir):
        print(f"❌ Error: Source directory '{source_dir}' does not exist.")
        return

    # Create destination directory if it doesn't exist
    if not os.path.exists(destination_dir):
        os.makedirs(destination_dir)
        print(f"📁 Created directory: '{destination_dir}'")

    moved_count = 0

    # Scan and move files
    for filename in os.listdir(source_dir):
        # Check for both .jpg and .jpeg (case-insensitive)
        if filename.lower().endswith(('.jpg', '.jpeg')):
            source_file = os.path.join(source_dir, filename)
            dest_file = os.path.join(destination_dir, filename)

            # Move the file
            shutil.move(source_file, dest_file)
            print(f"Moved: {filename} ➔ {destination_dir}/")
            moved_count += 1

    print("\n" + "=" * 40)
    print(f"✅ Automation complete! Total files moved: {moved_count}")
    print("=" * 40)

if __name__ == "__main__":
    # Specify your directories here:
    SOURCE_FOLDER = "./downloads"
    DEST_FOLDER = "./images"

    # Create dummy folder/files for testing if needed
    os.makedirs(SOURCE_FOLDER, exist_ok=True)
    
    organize_jpg_images(SOURCE_FOLDER, DEST_FOLDER)
